<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique Android 6 à 11 : tout est exclu, l'appli se veut 100 % hors ligne. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
