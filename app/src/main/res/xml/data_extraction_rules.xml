<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde Android 12 et plus. La sauvegarde du système vers le compte Google de la personne
    est autorisée : c'est Android qui la gère, si la personne l'a activée sur son téléphone.
    Sillon n'envoie rien lui-même, n'a ni compte ni serveur, et le transfert direct d'un téléphone à l'autre
    reste permis pour ne pas perdre le potager au changement d'appareil.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" />
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" />
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="external" />
    </device-transfer>
</data-extraction-rules>
