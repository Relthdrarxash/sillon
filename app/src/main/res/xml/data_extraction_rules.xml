<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde Android 12 et plus. SillonBackupAgent applique en plus le choix de la personne :
    sauvegarde dans le compte Google désactivée par défaut, et jamais sans chiffrement de bout en bout.
    Le transfert direct vers un nouveau téléphone reste toujours permis.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
